    background-color: #1c2228;
    color: #e8ecf0;
    font-family: "Noto Sans", "Segoe UI", sans-serif;
    font-size: 13px;
}
QLabel#title {
    color: #d4af37;
    font-size: 22px;
    font-weight: 700;
}
QLabel#subtitle {
    color: #a8b3be;
    font-size: 13px;
}
QFrame#card {
    background-color: #242c34;
    border: 1px solid #35414d;
    border-radius: 8px;
    padding: 8px;
}
