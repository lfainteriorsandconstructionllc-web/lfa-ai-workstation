#!/usr/bin/env python3
"""
LFA AI Setup — First-run graphical assistant for LFA AI Workstation.
Lets the user install third-party AI & developer tools directly from their
official upstream sources, and apply the LFA Dorado + Living Landscapes theme.
License: GPL-3.0-or-later
"""

import os
import shutil
import subprocess
import sys
from pathlib import Path

from PyQt6.QtCore import QProcess, Qt
from PyQt6.QtGui import QFont
from PyQt6.QtWidgets import (
    QApplication,
    QCheckBox,
    QFrame,
    QHBoxLayout,
    QLabel,
    QMessageBox,
    QPushButton,
    QScrollArea,
    QTextEdit,
    QVBoxLayout,
    QWidget,
)

MARKER = Path.home() / ".config" / "lfa-ai-setup.done"

TOOLS = [
    (
        "theme",
        "Aplicar tema LFA Dorado 1.3 + Paisaje Vivo 0.6.4",
        "Activa el estilo visual LFA Dorado y el fondo dinámico de KDE Plasma 6 para tu usuario.",
        True,
        "lfa-apply-theme",
    ),
    (
        "uv",
        "uv (gestor ultrarrápido de Python y servidores MCP)",
        "Instalación oficial desde astral.sh/uv (recomendado para agentes y MCP).",
        True,
        "curl -LsSf https://astral.sh/uv/install.sh | sh",
    ),
    (
        "nodejs",
        "Node.js LTS + npm (base para Claude Code, Codex CLI y MCP)",
        "Instala nodejs y npm desde repositorios oficiales.",
        True,
        "pkexec bash -c 'apt-get update -qq && apt-get install -y nodejs npm'",
    ),
    (
        "gh",
        "GitHub CLI (gh)",
        "Herramienta oficial de GitHub para repositorios, PRs y releases.",
        True,
        "pkexec bash -c 'apt-get update -qq && apt-get install -y gh'",
    ),
    (
        "claude_code",
        "Claude Code CLI (@anthropic-ai/claude-code)",
        "Instala el agente oficial de Anthropic vía npm en ~/.local.",
        False,
        "npm install -g --prefix \"$HOME/.local\" @anthropic-ai/claude-code",
    ),
    (
        "codex_cli",
        "OpenAI Codex CLI (@openai/codex)",
        "Instala el agente oficial de OpenAI vía npm en ~/.local.",
        False,
        "npm install -g --prefix \"$HOME/.local\" @openai/codex",
    ),
    (
        "chrome",
        "Google Chrome (repositorio oficial de Google)",
        "Descarga e instala el paquete .deb oficial de Google Chrome.",
        False,
        "pkexec bash -c 'tmp=$(mktemp -d) && curl -fsSL https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb -o \"$tmp/chrome.deb\" && apt-get install -y \"$tmp/chrome.deb\" && rm -rf \"$tmp\"'",
    ),
    (
        "docker",
        "Docker Engine (contenedores para IA y microservicios)",
        "Instala docker.io y agrega tu usuario al grupo docker.",
        False,
        f"pkexec bash -c 'apt-get update -qq && apt-get install -y docker.io docker-compose-v2 && usermod -aG docker {os.environ.get('USER', '')}'",
    ),
    (
        "kaichat",
        "KAIChat (cliente oficial de IA de KDE vía Flathub)",
        "Instala org.kde.kaichat (Qt6/Kirigami, soporta Ollama, OpenAI, Claude, Groq y MCP).",
        False,
        "flatpak remote-add --if-not-exists --user flathub https://flathub.org/repo/flathub.flatpakrepo && flatpak install -y --user flathub org.kde.kaichat",
    ),
    (
        "ollama",
        "Ollama (opcional — modelos locales)",
        "Instalador oficial desde ollama.com para ejecutar LLMs locales.",
