    font-weight: 600;
    color: #f0f3f6;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #d4af37;
    background: #1c2228;
}
