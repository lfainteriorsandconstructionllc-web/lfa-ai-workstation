    background-color: #dbb439;
}
QPushButton:disabled {
    opacity: 0.5;
}
QTextEdit {
    background-color: #13171b;
    border: 1px solid #2f3a45;
    border-radius: 6px;
    color: #cfd8e3;
    font-family: "JetBrains Mono", "Monospace", monospace;
    font-size: 12px;
}
"""


class SetupWindow(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("LFA AI Workstation — Asistente de configuración")
        self.resize(740, 660)
        self.setStyleSheet(STYLESHEET)

        self.checkboxes = {}
        self.queue = []
        self.proc = None

        root = QVBoxLayout(self)
        root.setContentsMargins(22, 20, 22, 18)
        root.setSpacing(12)

        title = QLabel("LFA AI Workstation")
        title.setObjectName("title")
        subtitle = QLabel(
            "Entorno KDE Plasma 6 optimizado para múltiples agentes de IA en la nube.\n"
            "Selecciona las herramientas oficiales que deseas instalar ahora (puedes volver a abrir este asistente desde el menú)."
        )
        subtitle.setObjectName("subtitle")
        subtitle.setWordWrap(True)

        root.addWidget(title)
        root.addWidget(subtitle)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.Shape.NoFrame)
        container = QWidget()
        clayout = QVBoxLayout(container)
        clayout.setSpacing(8)
        clayout.setContentsMargins(0, 0, 6, 0)

        for key, label, desc, default_checked, cmd in TOOLS:
            card = QFrame()
            card.setObjectName("card")
            v = QVBoxLayout(card)
            v.setContentsMargins(10, 8, 10, 8)
            v.setSpacing(2)
            cb = QCheckBox(label)
            cb.setChecked(default_checked)
            d = QLabel(desc)
            d.setObjectName("desc")
            d.setWordWrap(True)
            v.addWidget(cb)
            v.addWidget(d)
            clayout.addWidget(card)
            self.checkboxes[key] = (cb, label, cmd)

        clayout.addStretch(1)
        scroll.setWidget(container)
        root.addWidget(scroll, stretch=3)

        self.log = QTextEdit()
        self.log.setReadOnly(True)
        self.log.setPlaceholderText("Registro de instalación...")
        root.addWidget(self.log, stretch=2)

        btn_row = QHBoxLayout()
        self.dont_show = QCheckBox("No mostrar automáticamente al iniciar sesión")
        self.dont_show.setChecked(True)
        btn_row.addWidget(self.dont_show)
        btn_row.addStretch(1)

        self.close_btn = QPushButton("Cerrar")
        self.close_btn.clicked.connect(self.close)
        self.run_btn = QPushButton("Instalar seleccionados")
        self.run_btn.setObjectName("primary")
        self.run_btn.clicked.connect(self.start_install)
        btn_row.addWidget(self.close_btn)
        btn_row.addWidget(self.run_btn)
        root.addLayout(btn_row)

    def append_log(self, text: str):
        self.log.append(text.rstrip())

    def start_install(self):
        self.queue = [
            (label, cmd)
            for key, (cb, label, cmd) in self.checkboxes.items()
            if cb.isChecked()
        ]
        if not self.queue:
            QMessageBox.information(self, "LFA AI Setup", "No seleccionaste ninguna opción.")
            return

        self.run_btn.setEnabled(False)
        self.log.clear()
        self.append_log("==> Iniciando instalación de elementos seleccionados...")
        self.run_next()

    def run_next(self):
        if not self.queue:
            self.append_log("\n==> ¡Todo terminado!")
            self.run_btn.setEnabled(True)
            if self.dont_show.isChecked():
                MARKER.parent.mkdir(parents=True, exist_ok=True)
                MARKER.write_text("completed\n", encoding="utf-8")
            QMessageBox.information(
                self,
                "LFA AI Setup",
                "Instalación finalizada. Revisa el registro si algún paso requirió atención.",
            )
            return

        label, cmd = self.queue.pop(0)
        self.append_log(f"\n--- {label} ---")
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self.on_output)
        self.proc.finished.connect(self.on_finished)
        self.proc.start("bash", ["-lc", cmd])

    def on_output(self):
        if self.proc:
            data = bytes(self.proc.readAllStandardOutput()).decode("utf-8", errors="replace")
            if data.strip():
                self.append_log(data)

    def on_finished(self, code, _status):
        if code == 0:
            self.append_log("✓ Completado.")
        else:
            self.append_log(f"⚠ Finalizó con código {code}.")
        self.run_next()

    def closeEvent(self, event):
        if self.dont_show.isChecked():
            MARKER.parent.mkdir(parents=True, exist_ok=True)
            if not MARKER.exists():
                MARKER.write_text("dismissed\n", encoding="utf-8")
        super().closeEvent(event)


def main():
    if "--autostart" in sys.argv and MARKER.exists():
        sys.exit(0)
    app = QApplication(sys.argv)
    app.setFont(QFont("Noto Sans", 10))
    win = SetupWindow()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
