def find_icon_path():
    candidates = [
        "/usr/share/icons/hicolor/256x256/apps/lfa-ai-assistant.png",
        "/usr/share/icons/hicolor/512x512/apps/lfa-ai-assistant.png",
        str(Path.home() / ".local/share/icons/hicolor/256x256/apps/lfa-ai-assistant.png"),
        "/usr/share/icons/LFA/apps/512/lfa-logo.png",
    ]
    for p in candidates:
        if os.path.exists(p):
            return p
    return ""


def load_config():
    if CONFIG_FILE.exists():
        try:
            cfg = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
            if isinstance(cfg, dict) and cfg.get("provider") in PROVIDERS:
                return cfg
        except Exception:
            pass
    return {
        "provider": "LFA AI Gratis (Sin API Key)",
        "model": "openai",
        "api_key": "",
        "system_prompt": (
            "Eres LFA AI Assistant, el asistente nativo integrado en LFA AI OS. "
            "Responde de forma clara, útil, amable y en el idioma del usuario."
        ),
    }


def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(cfg, indent=2, ensure_ascii=False), encoding="utf-8")
    try:
        os.chmod(CONFIG_FILE, 0o600)
    except OSError:
        pass


def md_to_html(text):
    """Lightweight safe Markdown-to-HTML renderer for chat bubbles."""
    if not text:
        return ""
    blocks = re.split(r"(```[\s\S]*?```)", text)
    out = []
    for block in blocks:
        if block.startswith("```") and block.endswith("```"):
            inner = block[3:-3]
            if "\n" in inner:
                first_line, rest = inner.split("\n", 1)
                if len(first_line.strip()) <= 20 and " " not in first_line.strip():
                    inner = rest
            safe_code = html.escape(inner.strip("\n"))
            out.append(
                "<pre style='background:#0c1014; border:1px solid #2e3944; border-radius:6px; "
                "padding:10px; color:#ecd6a0; font-family:monospace; white-space:pre-wrap;'>"
                f"{safe_code}</pre>"
            )
        else:
            safe = html.escape(block)
            safe = re.sub(
                r"`([^`\n]+)`",
                r"<code style='background:#0f1419; color:#ecd6a0; padding:1px 5px; border-radius:4px;'>\1</code>",
                safe,
            )
            safe = re.sub(r"\*\*([^\*\n]+)\*\*", r"<b>\1</b>", safe)
            safe = re.sub(r"(?m)^###\s+(.+)$", r"<div style='color:#e0be63; font-weight:700; margin-top:6px;'>\1</div>", safe)
            safe = re.sub(r"(?m)^##\s+(.+)$", r"<div style='color:#e0be63; font-weight:700; font-size:15px; margin-top:8px;'>\1</div>", safe)
            safe = safe.replace("\n", "<br>")
            out.append(safe)
    return "".join(out)


class ApiWorker(QThread):
    finished_ok = pyqtSignal(str)
    finished_err = pyqtSignal(str)

    def __init__(self, cfg, messages, parent=None):
        super().__init__(parent)
        self.cfg = dict(cfg)
        self.messages = [dict(m) for m in messages]

    def _call_pollinations_openai(self, model, msgs):
        payload = {"model": model, "messages": msgs}
        req = urllib.request.Request(
            "https://text.pollinations.ai/openai",
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json", "User-Agent": "LFA-AI-OS/1.0"},
        )
        with urllib.request.urlopen(req, timeout=60) as resp:
            raw = resp.read().decode("utf-8", errors="replace").strip()
        data = json.loads(raw)
        choices = data.get("choices") or []
        if not choices:
            raise ValueError("Respuesta vacía del servidor gratuito.")
        msg = choices[0].get("message") or {}
        content = (msg.get("content") or "").strip()
        if not content:
            raise ValueError("El modelo devolvió un texto vacío.")
        return content

    def _call_pollinations_simple(self, last_prompt):
        url = "https://text.pollinations.ai/" + urllib.parse.quote(last_prompt, safe="")
        req = urllib.request.Request(url, headers={"User-Agent": "LFA-AI-OS/1.0"})
        with urllib.request.urlopen(req, timeout=45) as resp:
            txt = resp.read().decode("utf-8", errors="replace").strip()
        if not txt:
            raise ValueError("Respuesta vacía del respaldo gratuito.")
        return txt

    def run(self):
        try:
            prov_name = self.cfg.get("provider", "LFA AI Gratis (Sin API Key)")
            prov = PROVIDERS.get(prov_name, PROVIDERS["LFA AI Gratis (Sin API Key)"])
            ptype = prov["type"]
            model = (self.cfg.get("model") or prov["default_model"]).strip()
            api_key = (self.cfg.get("api_key") or "").strip()
            sys_prompt = self.cfg.get("system_prompt", "")

            if ptype == "free_public":
                msgs = []
                if sys_prompt:
                    msgs.append({"role": "system", "content": sys_prompt})
                msgs.extend(self.messages[-16:])
                last_err = None
                for candidate_model in [model, "openai-fast", "mistral"]:
                    if self.isInterruptionRequested():
                        return
                    try:
                        reply = self._call_pollinations_openai(candidate_model, msgs)
                        self.finished_ok.emit(reply)
                        return
                    except Exception as exc:
                        last_err = exc
                if not self.isInterruptionRequested():
                    try:
                        last_user = self.messages[-1]["content"] if self.messages else "Hola"
                        reply = self._call_pollinations_simple(last_user)
                        self.finished_ok.emit(reply)
                        return
                    except Exception as exc:
                        last_err = exc
                self.finished_err.emit(
                    f"No se pudo conectar con el servicio gratuito en este momento.\n"
                    f"Verifica tu conexión a internet o prueba de nuevo.\n\nDetalle: {last_err}"
                )
                return

            if ptype in ("gemini", "openai") and not api_key:
                self.finished_err.emit(
                    f"Falta la API Key para {prov_name}.\n"
                    f"Haz clic en 'Configurar' para pegarla ({prov['hint']})."
                )
                return

            if ptype == "gemini":
                url = prov["url"].format(model=model) + f"?key={api_key}"
                contents = []
                for m in self.messages[-20:]:
                    role = "user" if m["role"] == "user" else "model"
                    contents.append({"role": role, "parts": [{"text": m["content"]}]})
                payload = {"contents": contents}
                if sys_prompt:
                    payload["systemInstruction"] = {"parts": [{"text": sys_prompt}]}
                req = urllib.request.Request(
                    url,
                    data=json.dumps(payload).encode("utf-8"),
                    headers={"Content-Type": "application/json"},
                )
                with urllib.request.urlopen(req, timeout=90) as resp:
                    data = json.loads(resp.read().decode("utf-8"))
                parts = data["candidates"][0]["content"]["parts"]
                reply = "".join(p.get("text", "") for p in parts).strip()
                self.finished_ok.emit(reply or "(Sin contenido)")
                return

            if ptype == "openai":
                msgs = []
                if sys_prompt:
                    msgs.append({"role": "system", "content": sys_prompt})
                msgs.extend(self.messages[-20:])
                payload = {"model": model, "messages": msgs}
                req = urllib.request.Request(
                    prov["url"],
                    data=json.dumps(payload).encode("utf-8"),
                    headers={
                        "Content-Type": "application/json",
                        "Authorization": f"Bearer {api_key}",
                    },
                )
                with urllib.request.urlopen(req, timeout=90) as resp:
                    data = json.loads(resp.read().decode("utf-8"))
                reply = (data["choices"][0]["message"].get("content") or "").strip()
                self.finished_ok.emit(reply or "(Sin contenido)")
                return

            if ptype == "ollama":
                msgs = []
                if sys_prompt:
                    msgs.append({"role": "system", "content": sys_prompt})
                msgs.extend(self.messages[-20:])
                payload = {"model": model, "messages": msgs, "stream": False}
                req = urllib.request.Request(
                    prov["url"],
                    data=json.dumps(payload).encode("utf-8"),
                    headers={"Content-Type": "application/json"},
                )
                with urllib.request.urlopen(req, timeout=180) as resp:
                    data = json.loads(resp.read().decode("utf-8"))
                reply = (data["message"].get("content") or "").strip()
                self.finished_ok.emit(reply or "(Sin contenido)")
                return

        except urllib.error.HTTPError as e:
            body = e.read().decode("utf-8", errors="replace")[:400]
            self.finished_err.emit(f"Error HTTP {e.code}: {body}")
        except Exception as e:
            self.finished_err.emit(f"Error de conexión: {e}")


class SettingsDialog(QDialog):
    def __init__(self, cfg, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Configurar LFA AI Assistant")
        self.resize(520, 300)
        self.setStyleSheet(STYLESHEET)
        self.cfg = dict(cfg)

        layout = QVBoxLayout(self)
        form = QFormLayout()

        self.prov_combo = QComboBox()
        self.prov_combo.addItems(list(PROVIDERS.keys()))
        idx = self.prov_combo.findText(self.cfg.get("provider", ""))
        if idx >= 0:
            self.prov_combo.setCurrentIndex(idx)
        self.prov_combo.currentTextChanged.connect(self.on_provider_change)

        self.model_edit = QLineEdit(self.cfg.get("model", ""))
        self.key_edit = QLineEdit(self.cfg.get("api_key", ""))
        self.key_edit.setEchoMode(QLineEdit.EchoMode.Password)
        self.key_edit.setPlaceholderText("Opcional en modo gratuito o Ollama")
        self.hint_label = QLabel()
        self.hint_label.setObjectName("sub")
        self.hint_label.setWordWrap(True)

        form.addRow("Proveedor:", self.prov_combo)
        form.addRow("Modelo:", self.model_edit)
        form.addRow("API Key:", self.key_edit)
        form.addRow("", self.hint_label)
        layout.addLayout(form)

        btns = QHBoxLayout()
        btns.addStretch(1)
        cancel_btn = QPushButton("Cancelar")
        cancel_btn.clicked.connect(self.reject)
        save_btn = QPushButton("Guardar")
        save_btn.setObjectName("primary")
        save_btn.clicked.connect(self.accept)
        btns.addWidget(cancel_btn)
        btns.addWidget(save_btn)
        layout.addLayout(btns)

        self.on_provider_change(self.prov_combo.currentText(), keep_model=True)

    def on_provider_change(self, name, keep_model=False):
        p = PROVIDERS[name]
        self.hint_label.setText(p["hint"])
        needs_key = p["type"] in ("gemini", "openai")
        self.key_edit.setEnabled(needs_key)
        if not keep_model:
            self.model_edit.setText(p["default_model"])

    def result_config(self):
        self.cfg["provider"] = self.prov_combo.currentText()
        self.cfg["model"] = (
            self.model_edit.text().strip() or PROVIDERS[self.cfg["provider"]]["default_model"]
        )
        self.cfg["api_key"] = self.key_edit.text().strip()
        return self.cfg


class AssistantWindow(QWidget):
    def __init__(self):
        super().__init__()
        self.cfg = load_config()
        self.messages = self.load_history()
        self.worker = None

        self.setWindowTitle("LFA AI Assistant")
        self.resize(820, 660)
        self.setStyleSheet(STYLESHEET)

        icon_path = find_icon_path()
        if icon_path:
            self.setWindowIcon(QIcon(icon_path))

        root = QVBoxLayout(self)
        root.setContentsMargins(18, 16, 18, 16)
        root.setSpacing(12)

        header = QHBoxLayout()
        if icon_path:
            logo_lbl = QLabel()
            pix = QPixmap(icon_path).scaled(
                42, 42, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation
            )
            logo_lbl.setPixmap(pix)
            header.addWidget(logo_lbl)

        title_box = QVBoxLayout()
        title_box.setSpacing(2)
        lbl = QLabel("LFA AI Assistant")
        lbl.setObjectName("brand")
        self.status_lbl = QLabel()
        self.status_lbl.setObjectName("sub")
        title_box.addWidget(lbl)
        title_box.addWidget(self.status_lbl)
        header.addLayout(title_box)
        header.addStretch(1)

        clear_btn = QPushButton("Limpiar")
        clear_btn.clicked.connect(self.clear_chat)
        copy_btn = QPushButton("Copiar última")
        copy_btn.clicked.connect(self.copy_last)
        cfg_btn = QPushButton("Configurar")
        cfg_btn.clicked.connect(self.open_settings)
        header.addWidget(clear_btn)
        header.addWidget(copy_btn)
        header.addWidget(cfg_btn)
        root.addLayout(header)

        self.chat = QTextBrowser()
        self.chat.setOpenExternalLinks(True)
        root.addWidget(self.chat, stretch=1)

        input_row = QHBoxLayout()
        self.prompt = QTextEdit()
        self.prompt.setFixedHeight(78)
        self.prompt.setPlaceholderText("Escribe tu pregunta y pulsa Enter para enviar (Shift+Enter para nueva línea)...")
        self.prompt.installEventFilter(self)

        self.send_btn = QPushButton("Enviar")
        self.send_btn.setObjectName("primary")
        self.send_btn.setFixedHeight(78)
        self.send_btn.setFixedWidth(108)
        self.send_btn.clicked.connect(self.send_message)
        input_row.addWidget(self.prompt, stretch=1)
        input_row.addWidget(self.send_btn)
        root.addLayout(input_row)

        self.refresh_status()
        self.render_messages()

    def eventFilter(self, obj, event):
        if obj is self.prompt and event.type() == event.Type.KeyPress:
            if event.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter):
                mods = event.modifiers()
                if mods & Qt.KeyboardModifier.ShiftModifier:
                    return False
                self.send_message()
                return True
        return super().eventFilter(obj, event)

    def refresh_status(self):
        self.status_lbl.setText(f"{self.cfg.get('provider')} · {self.cfg.get('model')}")

    def load_history(self):
        if HISTORY_FILE.exists():
            try:
                data = json.loads(HISTORY_FILE.read_text(encoding="utf-8"))
                if isinstance(data, list):
                    return [m for m in data[-40:] if isinstance(m, dict) and "role" in m and "content" in m]
            except Exception:
                pass
        return []

    def save_history(self):
        try:
            HISTORY_DIR.mkdir(parents=True, exist_ok=True)
            HISTORY_FILE.write_text(
                json.dumps(self.messages[-40:], indent=2, ensure_ascii=False), encoding="utf-8"
            )
        except OSError:
            pass

    def render_messages(self):
        if not self.messages:
            self.chat.setHtml(
                "<div style='color:#9aa7b4; padding:16px; line-height:1.6;'>"
                "<div style='color:#e0be63; font-size:16px; font-weight:700; margin-bottom:8px;'>"
                "Bienvenido a LFA AI Assistant</div>"
                "Listo para conversar <b>gratis y sin clave API</b>.<br>"
                "Escribe cualquier pregunta abajo y pulsa <b>Enter</b> o <b>Enviar</b>.<br><br>"
                "<span style='color:#7d8c9b;'>También puedes usar tu propia API Key de Google Gemini, Groq, "
                "OpenRouter o un modelo local en Ollama desde <b>Configurar</b>.</span>"
                "</div>"
            )
            return

        html_parts = []
        for m in self.messages:
            body = md_to_html(str(m.get("content", "")))
            if m.get("role") == "user":
                html_parts.append(
                    "<div style='margin:8px 0; padding:10px 14px; background:#222c36; "
                    "border-left:3px solid #d4af37; border-radius:8px;'>"
                    f"<b style='color:#e0be63;'>Tú</b><div style='margin-top:4px;'>{body}</div></div>"
                )
            else:
                html_parts.append(
                    "<div style='margin:8px 0; padding:10px 14px; background:#192129; "
                    "border-left:3px solid #9e8a55; border-radius:8px;'>"
                    f"<b style='color:#f0d78c;'>LFA AI</b><div style='margin-top:4px;'>{body}</div></div>"
                )
        self.chat.setHtml("".join(html_parts))
        sb = self.chat.verticalScrollBar()
        sb.setValue(sb.maximum())

    def send_message(self):
        text = self.prompt.toPlainText().strip()
        if not text or self.worker is not None:
            return
        self.prompt.clear()
        self.messages.append({"role": "user", "content": text})
        self.render_messages()
        self.send_btn.setEnabled(False)
        self.send_btn.setText("...")
        self.status_lbl.setText("Pensando...")

        worker = ApiWorker(self.cfg, self.messages, self)
        self.worker = worker
        worker.finished_ok.connect(self.on_reply)
        worker.finished_err.connect(self.on_error)
        worker.finished.connect(self.on_worker_finished)
        worker.start()

    def on_worker_finished(self):
        w = self.worker
        self.worker = None
        if w is not None:
            w.deleteLater()
        self.send_btn.setEnabled(True)
        self.send_btn.setText("Enviar")
        self.refresh_status()
        self.prompt.setFocus()

    def on_reply(self, reply):
        self.messages.append({"role": "assistant", "content": reply})
        self.save_history()
        self.render_messages()

    def on_error(self, err):
        QMessageBox.warning(self, "LFA AI Assistant", err)

    def closeEvent(self, event):
        if self.worker is not None and self.worker.isRunning():
            self.worker.requestInterruption()
            self.worker.wait(1500)
        super().closeEvent(event)

    def clear_chat(self):
        self.messages = []
        self.save_history()
        self.render_messages()

    def copy_last(self):
        for m in reversed(self.messages):
            if m.get("role") == "assistant":
                QApplication.clipboard().setText(m.get("content", ""))
                self.status_lbl.setText("Última respuesta copiada al portapapeles")
                return

    def open_settings(self):
        dlg = SettingsDialog(self.cfg, self)
        if dlg.exec() == QDialog.DialogCode.Accepted:
            self.cfg = dlg.result_config()
            save_config(self.cfg)
            self.refresh_status()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("LFA AI Assistant")
    app.setFont(QFont("Noto Sans", 10))
    win = AssistantWindow()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
